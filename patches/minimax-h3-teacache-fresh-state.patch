+    @classmethod
+    def IS_CHANGED(cls, *args, **kwargs):
+        """Rebuild the wrapper state for every queued prompt.
+
+        ComfyUI caches MODEL patch-node outputs across prompts when their
+        inputs do not change.  TeaCacheState is sampling-run state, so reusing
+        that patched MODEL could carry step counters and cached tensors into a
+        later run.  A NaN fingerprint is deliberately self-unequal and is the
+        V1-node mechanism ComfyUI uses to force re-execution.
+        """
