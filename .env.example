# Copy to .env in this checkout. Process environment values take precedence.
# Simple KEY=VALUE only: no shell commands, export, substitutions, or interpolation.
# Use absolute paths or ~ for COMFY_HOME and WEB_COMFYUI_* directories.
COMFY_HOME=~/comfyui
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_BROWSER_URL=http://127.0.0.1:8188
CASTLE_COMFY_WEB_HOST=127.0.0.1
CASTLE_COMFY_WEB_PORT=8190

# Optional separate application data/cache on disk (defaults shown in docs).
# WEB_COMFYUI_DATA_DIR=/absolute/path/to/web-comfyui-data
# WEB_COMFYUI_CACHE_DIR=/absolute/path/to/web-comfyui-cache
# WEB_COMFYUI_TMP_DIR=/absolute/disk/path/to/web-comfyui-tmp

# Optional API credentials: use your own values locally. Never commit .env.
OPENAI_API_KEY=
GEMINI_API_KEY=
# CASTLE_POST_OPENAI_MODEL=gpt-4o-mini
# CASTLE_POST_GEMINI_MODEL=gemini-2.5-flash
# CASTLE_CLAUDE_CLI=/absolute/path/to/claude
# Optional explicit KEY=VALUE secrets file; no other projects are searched.
# CASTLE_VOICE_LAB_ENV=/absolute/private/path/to/api.env

# Google Drive import, using your own OAuth client and registered callback.
CASTLE_GOOGLE_CLIENT_ID=
CASTLE_GOOGLE_CLIENT_SECRET=
CASTLE_GOOGLE_REDIRECT_URI=

# Optional operator identity for restricted tools with account-based login.
# Local first-run admin sessions already have operator access.
CASTLE_OPERATOR_EMAIL=

# Optional voice/reel installations are external dependencies, not bundled assets.
# CASTLE_BREEZY_URL=http://127.0.0.1:8231
# CASTLE_VOICE_LAB_PYTHON=/absolute/path/to/voice-environment/bin/python
# CASTLE_GPU_QUEUE_SCRIPT=/absolute/path/to/gpu_queue.py
# CASTLE_VOXCPM_PYTHON=/absolute/path/to/voxcpm-environment/bin/python
# CASTLE_VOXCPM_MODEL_PATH=/absolute/path/to/VoxCPM2
# CASTLE_CUSTOM_ENGLISH_LORA=/absolute/path/to/custom/lora
# CASTLE_CUSTOM_ENGLISH_REFERENCE_AUDIO=/absolute/path/to/reference.wav
# CASTLE_CUSTOM_ENGLISH_REFERENCE_TEXT=Exact transcript of your reference audio.
# CASTLE_REEL5_SOURCE_ROOT=/absolute/path/to/your/reel/runtime

# Optional integrations require explicit setup; none is enabled by this example.
# AISISTER_BASE=https://your-configured-service.example
# CASTLE_AUTOIP_WEBHOOK_ACCOUNT_ID=local-autoip
# CASTLE_AUTOIP_WEBHOOK_URL=https://your-configured-service.example/api/providers/autoip/webhook
# CASTLE_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# CASTLE_CANONICAL_WEB_ORIGIN=https://your-ui.example
# CASTLE_ALLOWED_ORIGIN_HOSTS=your-ui.example
