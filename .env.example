# Copy to .env in this checkout. Process environment values take precedence.
# Simple KEY=VALUE only: no shell commands, export, substitutions, or interpolation.
# Use absolute paths or ~ for COMFY_HOME and WEB_COMFYUI_* directories.
COMFY_HOME=~/comfyui
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_BROWSER_URL=http://127.0.0.1:8188
WEB_COMFYUI_HOST=127.0.0.1
WEB_COMFYUI_PORT=8190

# Optional separate application data/cache on disk (defaults shown in docs).
# WEB_COMFYUI_DATA_DIR=/absolute/path/to/web-comfyui-data
# WEB_COMFYUI_CACHE_DIR=/absolute/path/to/web-comfyui-cache
# WEB_COMFYUI_TMP_DIR=/absolute/disk/path/to/web-comfyui-tmp

# Optional API credentials: use your own values locally. Never commit .env.
OPENAI_API_KEY=
GEMINI_API_KEY=
# WEB_COMFYUI_POST_OPENAI_MODEL=gpt-4o-mini
# WEB_COMFYUI_POST_GEMINI_MODEL=gemini-2.5-flash
# WEB_COMFYUI_CLAUDE_CLI=/absolute/path/to/claude
# Optional explicit KEY=VALUE secrets file; no other projects are searched.
# WEB_COMFYUI_VOICE_LAB_ENV=/absolute/private/path/to/api.env

# Google Drive import, using your own OAuth client and registered callback.
WEB_COMFYUI_GOOGLE_CLIENT_ID=
WEB_COMFYUI_GOOGLE_CLIENT_SECRET=
WEB_COMFYUI_GOOGLE_REDIRECT_URI=

# Optional operator identity for restricted tools with account-based login.
# Local first-run admin sessions already have operator access.
WEB_COMFYUI_OPERATOR_EMAIL=

# Optional voice/reel installations are external dependencies, not bundled assets.
# WEB_COMFYUI_BREEZY_URL=http://127.0.0.1:8231
# WEB_COMFYUI_VOICE_LAB_PYTHON=/absolute/path/to/voice-environment/bin/python
# WEB_COMFYUI_GPU_QUEUE_SCRIPT=/absolute/path/to/gpu_queue.py
# WEB_COMFYUI_VOXCPM_PYTHON=/absolute/path/to/voxcpm-environment/bin/python
# WEB_COMFYUI_VOXCPM_MODEL_PATH=/absolute/path/to/VoxCPM2
# WEB_COMFYUI_CUSTOM_ENGLISH_LORA=/absolute/path/to/custom/lora
# WEB_COMFYUI_CUSTOM_ENGLISH_REFERENCE_AUDIO=/absolute/path/to/reference.wav
# WEB_COMFYUI_CUSTOM_ENGLISH_REFERENCE_TEXT=Exact transcript of your reference audio.
# WEB_COMFYUI_REEL5_SOURCE_ROOT=/absolute/path/to/your/reel/runtime

# Optional integrations require explicit setup; none is enabled by this example.
# AISISTER_BASE=https://your-configured-service.example
# WEB_COMFYUI_AUTOIP_WEBHOOK_ACCOUNT_ID=local-autoip
# WEB_COMFYUI_AUTOIP_WEBHOOK_URL=https://your-configured-service.example/api/providers/autoip/webhook
# WEB_COMFYUI_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# WEB_COMFYUI_CANONICAL_WEB_ORIGIN=https://your-ui.example
# WEB_COMFYUI_ALLOWED_ORIGIN_HOSTS=your-ui.example

# One shared absolute lock path for every process using the same GPU.
# Default retains rtx5090.lock for coordination with existing queue processes.
# For a new GPU-neutral name, configure every worker to use the same path.
# WEB_COMFYUI_GPU_LOCK_PATH=/absolute/private/path/gpu0.lock
