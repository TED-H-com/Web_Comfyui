-        return {'tts_speech': torch.concat(tts_speeches, dim=1)}
+        # Group sentences into breath-length chunks instead of splitting on EVERY
+        # 。？！ — per-sentence generation resets prosody and inserts ragged gaps
+        # (the "斷句" choppiness). Most lines now synth as a single utterance, so the
+        # model produces its own natural intra-sentence pauses.
+        def vis_len(s):
+            return len(re.sub(r'\[:.*?\]', '', s))  # don't count 注音 annotations
+        sents = [p for p in re.split(r'(?<=[？！。.?!])\s*', tts_text) if p.strip()]
+        chunks, cur = [], ""
+        for s in sents:
+            if cur and vis_len(cur) + vis_len(s) > 70:  # stay under the ~80-token gen limit
+                chunks.append(cur)
+                cur = s
+            else:
+                cur += s
+        if cur:
+            chunks.append(cur)
+        if not chunks:
+            chunks = [tts_text]
+
+        tts_speeches = []
+        for idx, i in enumerate(chunks, start=1):
+            print(f"Synthesizing chunk {idx}/{len(chunks)} ({vis_len(i)} chars)")
+            model_input = self.frontend.frontend_zero_shot(i, prompt_text, prompt_speech_16k)
+            model_output = self.model.inference(**model_input)
+            tts_speeches.append(model_output['tts_speech'])
+
+        if len(tts_speeches) == 1:
+            return {'tts_speech': tts_speeches[0]}
+        # Smooth the seams of any multi-chunk line: trim ragged edge-silence,
+        # normalize the inter-chunk pause to a natural ~110ms, and short-fade the
+        # edges so the boundary doesn't click.
+        sr = 22050
+        fade = int(sr * 0.012)
+        gap = torch.zeros(1, int(sr * 0.11))
+        out = []
+        for k, w in enumerate(tts_speeches):
+            w = w.clone()
+            nz = (w.abs().squeeze(0) > 0.015).nonzero()
+            if len(nz):
+                w = w[:, int(nz[0]):int(nz[-1]) + 1]
+            if w.shape[1] > 2 * fade:
+                ramp = torch.linspace(0, 1, fade)
+                w[:, :fade] = w[:, :fade] * ramp
+                w[:, -fade:] = w[:, -fade:] * ramp.flip(0)
+            out.append(w)
+            if k < len(tts_speeches) - 1:
+                out.append(gap)
+        return {'tts_speech': torch.cat(out, dim=1)}
         
