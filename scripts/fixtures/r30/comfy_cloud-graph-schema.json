  "SAM3_VideoTrack": {
    "input": {
      "required": {
        "images": [
          "IMAGE",
          {
            "display_name": "images",
            "tooltip": "Video frames as batched images"
          }
        ],
        "model": [
          "MODEL",
          {
            "display_name": "model"
          }
        ],
        "detection_threshold": [
          "FLOAT",
          {
            "display_name": "detection_threshold",
            "tooltip": "Score threshold for text-prompted detection.",
            "default": 0.5,
            "min": 0.0,
            "max": 1.0,
            "step": 0.01
          }
        ],
        "max_objects": [
          "INT",
          {
            "display_name": "max_objects",
