[Unit]
Description=Web_Comfyui optional pinned Ollama runtime (loopback only)
After=network.target

[Service]
Type=simple
Environment="OLLAMA_HOST=127.0.0.1:11434"
Environment="OLLAMA_MODELS=%h/.local/share/ollama/models"
WorkingDirectory=%h
ExecStartPre=/usr/bin/mkdir -p "%h/.local/share/ollama/models"
ExecStart="%h/.local/opt/ollama-0.32.11/bin/ollama" serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
